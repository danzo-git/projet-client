{% extends 'base.html.twig' %}

{% block title %}Dashboard Administrateur | Electro{% endblock %}

{% block content %}
<div class="container">
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h1 class="card-title text-primary">Tableau de Bord Administrateur</h1>
                    <p class="text-muted">Bienvenue dans votre espace d'administration</p>
                </div>
            </div>
        </div>
    </div>
    </div>
    <!-- Statistiques Cards -->
    <div class="row">
        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex">
                    <div class="text-primary me-3">
                        <i class="fa fa-users fa-3x"></i>
                    </div>
                    <div>
                        <h5 class="card-title">Utilisateurs</h5>
                        <h3 class="mb-0">150</h3>
                        <p class="card-text text-success"><i class="fa fa-arrow-up"></i> +5% ce mois</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex">
                    <div class="text-success me-3">
                        <i class="fa fa-shopping-cart fa-3x"></i>
                    </div>
                    <div>
                        <h5 class="card-title">Ventes</h5>
                        <h3 class="mb-0">1200€</h3>
                        <p class="card-text text-success"><i class="fa fa-arrow-up"></i> +12% ce mois</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex">
                    <div class="text-danger me-3">
                        <i class="fa fa-exclamation-triangle fa-3x"></i>
                    </div>
                    <div>
                        <h5 class="card-title">Ruptures</h5>
                        <h3 class="mb-0">5</h3>
                        <p class="card-text text-danger"><i class="fa fa-arrow-up"></i> +2 depuis hier</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex">
                    <div class="text-warning me-3">
                        <i class="fa fa-cubes fa-3x"></i>
                    </div>
                    <div>
                        <h5 class="card-title">Produits</h5>
                        <h3 class="mb-0">87</h3>
                        <p class="card-text text-muted">Total en stock</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Graphiques -->
    <div class="row mb-4">
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">Évolution des ventes</h5>
                </div>
                <div class="card-body">
                    <canvas id="salesChart" height="250"></canvas>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">Répartition des produits</h5>
                </div>
                <div class="card-body">
                    <canvas id="productChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Dernières commandes -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Dernières commandes</h5>
                    <a href="#" class="btn btn-sm btn-outline-primary">Voir toutes</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Client</th>
                                    <th>Date</th>
                                    <th>Montant</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>#12345</td>
                                    <td>Jean Dupont</td>
                                    <td>15/03/2025</td>
                                    <td>129,99€</td>
                                    <td><span class="badge bg-success">Livré</span></td>
                                    <td><a href="#" class="btn btn-sm btn-outline-secondary">Détails</a></td>
                                </tr>
                                <tr>
                                    <td>#12344</td>
                                    <td>Marie Martin</td>
                                    <td>14/03/2025</td>
                                    <td>89,50€</td>
                                    <td><span class="badge bg-warning text-dark">En traitement</span></td>
                                    <td><a href="#" class="btn btn-sm btn-outline-secondary">Détails</a></td>
                                </tr>
                                <tr>
                                    <td>#12343</td>
                                    <td>Pierre Durand</td>
                                    <td>13/03/2025</td>
                                    <td>249,99€</td>
                                    <td><span class="badge bg-info">Expédié</span></td>
                                    <td><a href="#" class="btn btn-sm btn-outline-secondary">Détails</a></td>
                                </tr>
                                <tr>
                                    <td>#12342</td>
                                    <td>Sophie Bernard</td>
                                    <td>12/03/2025</td>
                                    <td>59,99€</td>
                                    <td><span class="badge bg-danger">Annulé</span></td>
                                    <td><a href="#" class="btn btn-sm btn-outline-secondary">Détails</a></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Actions rapides -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">Actions Rapides</h5>
                </div>
                <div class="card-body">
                    <div class="row justify-content-center">
                        <div class="col-md-2 col-sm-4 mb-3">
                            <a href="{{ path('app_user') }}" class="btn btn-light border w-100 py-3 h-100 d-flex flex-column align-items-center justify-content-center">
                                <i class="fa fa-users fa-2x mb-2 text-primary"></i>
                                <span>Gérer<br>Utilisateurs</span>
                            </a>
                        </div>
                        <div class="col-md-2 col-sm-4 mb-3">
                            <a href="{{ path('app_category') }}" class="btn btn-light border w-100 py-3 h-100 d-flex flex-column align-items-center justify-content-center">
                                <i class="fa fa-list fa-2x mb-2 text-success"></i>
                                <span>Gérer<br>Catégories</span>
                            </a>
                        </div>
                        <div class="col-md-2 col-sm-4 mb-3">
                            <a href="{{ path('app_sub_category_index') }}" class="btn btn-light border w-100 py-3 h-100 d-flex flex-column align-items-center justify-content-center">
                                <i class="fa fa-sitemap fa-2x mb-2 text-info"></i>
                                <span>Gérer<br>Sous-catégories</span>
                            </a>
                        </div>
                        <div class="col-md-2 col-sm-4 mb-3">
                            <a href="{{ path('app_product_index') }}" class="btn btn-light border w-100 py-3 h-100 d-flex flex-column align-items-center justify-content-center">
                                <i class="fa fa-cubes fa-2x mb-2 text-warning"></i>
                                <span>Gérer<br>Produits</span>
                            </a>
                        </div>
                        <div class="col-md-2 col-sm-4 mb-3">
                            <a href="#" class="btn btn-light border w-100 py-3 h-100 d-flex flex-column align-items-center justify-content-center">
                                <i class="fa fa-truck fa-2x mb-2 text-danger"></i>
                                <span>Gérer<br>Commandes</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Graphique des ventes
        const salesCtx = document.getElementById('salesChart').getContext('2d');
        const salesChart = new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Août', 'Sep', 'Oct', 'Nov', 'Déc'],
                datasets: [{
                    label: 'Ventes 2025',
                    data: [120, 190, 300, 500, 200, 300, 450, 400, 320, 280, 220, 170],
                    backgroundColor: 'rgba(54, 162, 235, 0.1)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 2,
                    tension: 0.4,
                    pointBackgroundColor: 'rgba(54, 162, 235, 1)'
                },
                {
                    label: 'Ventes 2024',
                    data: [100, 170, 260, 450, 180, 270, 400, 370, 290, 250, 200, 150],
                    backgroundColor: 'rgba(255, 99, 132, 0.05)',
                    borderColor: 'rgba(255, 99, 132, 0.7)',
                    borderWidth: 2,
                    borderDash: [5, 5],
                    tension: 0.4,
                    pointBackgroundColor: 'rgba(255, 99, 132, 0.7)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            drawBorder: false,
                            color: 'rgba(0, 0, 0, 0.05)'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });

        // Graphique de répartition des produits
        const productCtx = document.getElementById('productChart').getContext('2d');
        const productChart = new Chart(productCtx, {
            type: 'doughnut',
            data: {
                labels: ['Laptops', 'Smartphones', 'Cameras', 'Accessories'],
                datasets: [{
                    data: [30, 25, 15, 30],
                    backgroundColor: [
                        'rgba(54, 162, 235, 0.8)',
                        'rgba(255, 99, 132, 0.8)',
                        'rgba(255, 206, 86, 0.8)',
                        'rgba(75, 192, 192, 0.8)'
                    ],
                    borderColor: 'white',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                },
                cutout: '65%'
            }
        });
    });
</script>
{% endblock %}