

{% block content %}
<div class="invoice-container py-4">
    <!-- En-tête de la facture -->
    <div class="invoice-header mb-4">
        <div class="row align-items-center">
            <div class="col-6">
                <h1>FACTURE</h1>
                <h2>Commande #{{ order.id }}</h2>
            </div>
            <div class="col-6 text-end">
                <p class="invoice-date">Date: {{ order.createdAt|date('d/m/Y') }}</p>
                <p>Heure: {{ order.createdAt|date('H:i') }}</p>
            </div>
        </div>
        <hr class="my-3">
    </div>

    <!-- Informations client et livraison -->
    <div class="row mb-4">
        <!-- Informations client -->
        <div class="col-md-6">
            <div class="info-block">
                <h3>Informations Client</h3>
                <table class="info-table">
                    <tr>
                        <td><strong>Nom:</strong></td>
                        <td>{{ order.firstName }} {{ order.lastName }}</td>
                    </tr>
                    <tr>
                        <td><strong>Téléphone:</strong></td>
                        <td>{{ order.phone }}</td>
                    </tr>
                </table>
            </div>
        </div>
        
        <!-- Informations livraison -->
        <div class="col-md-6">
            <div class="info-block">
                <h3>Adresse de livraison</h3>
                <table class="info-table">
                    <tr>
                        <td><strong>Adresse:</strong></td>
                        <td>{{ order.address }}</td>
                    </tr>
                    {% if order.additionalAddress %}
                    <tr>
                        <td><strong>Complément:</strong></td>
                        <td>{{ order.additionalAddress }}</td>
                    </tr>
                    {% endif %}
                    <tr>
                        <td><strong>Ville:</strong></td>
                        <td>{{ order.city.name }}</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Détails des produits -->
    <div class="products-section mb-4">
        <h3>Produits commandés</h3>
        <table class="products-table">
            <thead>
                <tr>
                    <th class="product-col">Produit</th>
                    <th>Prix unitaire</th>
                    <th>Quantité</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                {% for item in order.orderProducts %}
                <tr>
                    <td class="product-info">
                        <div class="d-flex align-items-center">
                            <img src="{{ asset('uploads/' ~ item.product.productImages[0].imagePath) }}" 
                                 alt="{{ item.product.name }}" 
                                 class="product-image">
                            <div class="ms-3">
                                <div class="product-name">{{ item.product.name }}</div>
                                <div class="product-brand">{{ item.product.brand }}</div>
                            </div>
                        </div>
                    </td>
                    <td>{{ item.product.price }} FCFA</td>
                    <td>{{ item.quantity }}</td>
                    <td class="text-end">{{ item.product.price * item.quantity }} FCFA</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end">Frais de livraison</td>
                    <td class="text-end">{{ order.city.price }} FCFA</td>
                </tr>
                <tr class="total-row">
                    <td colspan="3" class="text-end"><strong>TOTAL</strong></td>
                    <td class="text-end"><strong>{{ order.totalPrice + order.city.price}} FCFA</strong></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Informations de paiement -->
    <div class="payment-section">
        <h3>Informations de paiement</h3>
        <div class="row">
            <div class="col-md-6">
                <p><strong>Méthode de paiement:</strong>
                    {% if order.paymentOnDelivery %}
                        Paiement à la livraison
                    {% else %}
                        Paiement en ligne
                    {% endif %}
                </p>
            </div>
           
        </div>
    </div>
    
    <!-- Pied de page -->
    <div class="invoice-footer">
        <hr class="my-3">
        <p class="text-center">Merci pour votre achat!</p>
        <p class="text-center small">Pour toute question concernant cette facture, veuillez nous contacter.</p>
    </div>
</div>

<style>
/* Styles généraux */
body {
    font-family: 'Arial', sans-serif;
    color: #333;
    line-height: 1.5;
}

.invoice-container {
    max-width: 210mm; /* Format A4 */
    margin: 0 auto;
    padding: 20mm;
    background-color: white;
}

h1, h2, h3 {
    color: #000;
    margin-bottom: 15px;
}

h1 {
    font-size: 24pt;
    font-weight: bold;
}

h2 {
    font-size: 16pt;
}

h3 {
    font-size: 12pt;
    text-transform: uppercase;
    border-bottom: 1px solid #eee;
    padding-bottom: 5px;
    margin-top: 0;
}

hr {
    border-color: #000;
    border-width: 1px;
}

/* En-tête */
.invoice-header h1 {
    color: #D10024;
    margin-bottom: 5px;
}

.invoice-date {
    font-weight: bold;
    margin-bottom: 5px;
}

/* Tableaux d'informations */
.info-block {
    margin-bottom: 20px;
}

.info-table {
    width: 100%;
    border-collapse: collapse;
}

.info-table td {
    padding: 5px 0;
    vertical-align: top;
}

.info-table td:first-child {
    width: 30%;
    font-weight: 600;
}

/* Tableau des produits */
.products-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
}

.products-table th, 
.products-table td {
    padding: 10px;
    border-bottom: 1px solid #ddd;
}

.products-table th {
    background-color: #f9f9f9;
    font-weight: bold;
    text-align: left;
}

.product-col {
    width: 40%;
}

.product-image {
    width: 60px;
    height: 60px;
    object-fit: contain;
    border-radius: 4px;
    border: 1px solid #eee;
    background-color: white;
}

.product-name {
    font-weight: bold;
}

.product-brand {
    font-size: 0.9em;
    color: #666;
}

.total-row {
    font-size: 1.1em;
    background-color: #f9f9f9;
}

.text-end {
    text-align: right;
}

/* Pied de page */
.invoice-footer {
    margin-top: 30px;
}

/* Bouton d'impression */
.print-button {
    background-color: #333;
    color: white;
    border: none;
    padding: 8px 15px;
    border-radius: 4px;
    cursor: pointer;
}

.print-button:hover {
    background-color: #D10024;
}

/* Styles spécifiques pour l'impression */
@media print {
    body {
        margin: 0;
        padding: 0;
        background: white;
    }
    
    .invoice-container {
        width: 100%;
        max-width: none;
        padding: 10mm;
        box-shadow: none;
    }
    
    .print-hide {
        display: none !important;
    }
    
    .products-table th {
        background-color: #f9f9f9 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    
    .total-row {
        background-color: #f9f9f9 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    
    /* S'assurer que les images s'impriment correctement */
    .product-image {
        max-width: 60px !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    
    /* Empêcher les sauts de page inappropriés */
    tr { page-break-inside: avoid; }
    .info-block { page-break-inside: avoid; }
    .products-section { page-break-inside: avoid; }
}
</style>
{% endblock %}