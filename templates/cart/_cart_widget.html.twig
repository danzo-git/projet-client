{# templates/cart/sidebar.html.twig #}
<div class="cart-sidebar fixed top-0 right-0 w-96 h-full bg-white shadow-lg z-50 transform transition-transform ease-in-out duration-300" id="cart-sidebar">
    <div class="flex justify-between items-center p-4 border-b">
        <div class="flex items-center">
            <i class="fa fa-shopping-cart mr-2 text-blue-600"></i>
            <h2 class="text-xl font-bold">Votre Panier</h2>
        </div>
        <button 
            onclick="toggleCartSidebar()"
            class="text-gray-500 hover:text-gray-800 transition-colors"
        >
            <i class="fa fa-times"></i>
        </button>
    </div>

    {% set cart = app.session.get('cart', []) %}
    
    {% if cart is not empty %}
        <div class="overflow-y-auto max-h-[calc(100vh-250px)] p-4">
            {% for id, quantity in cart %}
                {% set product = get_product_by_id(id) %}
                <div class="flex items-center border-b py-3 hover:bg-gray-50 transition-colors">
                    <img 
                        src="{{ asset('uploads/' ~ product.productImages[0].imagePath) }}" 
                        alt="{{ product.name }}" 
                        class="w-16 h-16 object-cover mr-4 rounded"
                    >
                    <div class="flex-grow">
                        <h3 class="font-semibold">{{ product.name }}</h3>
                        <p class="text-gray-600">
                            {{ quantity }} x {{ product.price|number_format(0, ',', ' ') }} FCFA
                        </p>
                    </div>
                    <a 
                        href="{{ path('app_cart_remove', {'id': id}) }}"
                        class="text-red-500 hover:text-red-700 transition-colors"
                    >
                        <i class="fa fa-trash"></i>
                    </a>
                </div>
            {% endfor %}
        </div>

        <div class="p-4 border-t">
            <div class="flex justify-between mb-4">
                <span class="font-bold">Total</span>
                <span class="font-bold text-blue-600">
                    {% set total = 0 %}
                    {% for id, quantity in cart %}
                        {% set product = get_product_by_id(id) %}
                        {% set total = total + (product.price * quantity) %}
                    {% endfor %}
                    {{ total|number_format(0, ',', ' ') }} FCFA
                </span>
            </div>
            <div class="flex space-x-2">
                <a 
                    href="{{ path('app_cart') }}"
                    class="flex-grow bg-blue-600 text-white py-2 rounded hover:bg-blue-700 transition-colors text-center"
                >
                    Voir Panier
                </a>
                <a 
                    href="{{ path('app_checkout') }}"
                    class="flex-grow bg-green-600 text-white py-2 rounded hover:bg-green-700 transition-colors text-center"
                >
                    Paiement
                </a>
            </div>
        </div>
    {% else %}
        <div class="flex flex-col items-center justify-center h-full text-gray-500 p-4">
            <i class="fa fa-shopping-cart text-6xl mb-4"></i>
            <p>Votre panier est vide</p>
        </div>
    {% endif %}
</div>

{# Add this to your main layout or base template #}
{% block stylesheets %}
    {{ parent() }}
    <style>
        .cart-sidebar {
            transform: translateX(100%);
        }
        .cart-sidebar.open {
            transform: translateX(0);
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function toggleCartSidebar() {
            const sidebar = document.getElementById('cart-sidebar');
            sidebar.classList.toggle('open');
        }

        // Optional: Add cart icon click event
        document.querySelector('.dropdown-toggle[data-toggle="dropdown"]').addEventListener('click', toggleCartSidebar);
    </script>
{% endblock %}