{{ form_start(form, {'attr': {'class': 'city-form'}}) }}
    <div class="form-container">
        <h2 class="form-title">{{ (button_label|default('Enregistrer')) == 'Enregistrer' ? 'Créer une ville' : 'Modifier la ville' }}</h2>
        
        <div class="form-group">
            {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'form-input', 'placeholder': 'Entrez le nom de la ville'}}) }}
            <div class="form-error">
                {{ form_errors(form.name) }}
            </div>
        </div>
        
        <div class="form-group">
            {{ form_label(form.price, null, {'label_attr': {'class': 'form-label'}}) }}
            <div class="input-with-symbol">
                {{ form_widget(form.price, {'attr': {'class': 'form-input', 'placeholder': '0.00'}}) }}
                <span class="input-symbol">€</span>
            </div>
            <div class="form-error">
                {{ form_errors(form.price) }}
            </div>
        </div>
        
        <div class="form-group">
            {{ form_label(form.complement, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.complement, {'attr': {'class': 'form-input', 'placeholder': 'Informations complémentaires'}}) }}
            <div class="form-error">
                {{ form_errors(form.complement) }}
            </div>
        </div>
        
        <div class="form-actions">
            <button type="submit" class="submit-btn">
                <i class="fas fa-save"></i> {{ button_label|default('Enregistrer') }}
            </button>
            <a href="{{ path('app_city_index') }}" class="cancel-btn">
                <i class="fas fa-times"></i> Annuler
            </a>
        </div>
    </div>
{{ form_end(form) }}

<style>
    .city-form {
        max-width: 600px;
        margin: 2rem auto;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    
    .form-container {
        background: white;
        padding: 2rem;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
    
    .form-title {
        color: #2c3e50;
        margin-top: 0;
        margin-bottom: 2rem;
        text-align: center;
        font-size: 1.8rem;
    }
    
    .form-group {
        margin-bottom: 1.5rem;
    }
    
    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #495057;
    }
    
    .form-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 1rem;
        transition: border-color 0.3s, box-shadow 0.3s;
    }
    
    .form-input:focus {
        border-color: #3498db;
        box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.2);
        outline: none;
    }
    
    .input-with-symbol {
        position: relative;
    }
    
    .input-symbol {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #7f8c8d;
    }
    
    .form-error {
        color: #e74c3c;
        font-size: 0.85rem;
        margin-top: 0.3rem;
    }
    
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2rem;
    }
    
    .submit-btn, .cancel-btn {
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        border: none;
    }
    
    .submit-btn {
        background-color: #2ecc71;
        color: white;
    }
    
    .submit-btn:hover {
        background-color: #27ae60;
        transform: translateY(-2px);
    }
    
    .cancel-btn {
        background-color: #f8f9fa;
        color: #495057;
        border: 1px solid #ddd;
    }
    
    .cancel-btn:hover {
        background-color: #e9ecef;
    }
    
    /* Style pour les erreurs de validation */
    .form-input.is-invalid {
        border-color: #e74c3c;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
        .form-container {
            padding: 1.5rem;
        }
        
        .form-title {
            font-size: 1.5rem;
        }
        
        .form-actions {
            flex-direction: column;
        }
        
        .submit-btn, .cancel-btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>