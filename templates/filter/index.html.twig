{% extends 'base.html.twig' %}

{% block title %}Collection-{{categorieName}}
{% endblock %}

{% block content %}
	<!-- SECTION -->
	<div
		class="section">
		<!-- container -->
		<div
			class="container">
			<!-- row -->
			<div
				class="row">
				<!-- ASIDE -->
				<div
					id="aside" class="col-md-3">
					<!-- aside Widget -->
					<div class="aside">
						<h3 class="aside-title">
							{{categorieName}}</h3>
						<div class="checkbox-filter"></div>
					</div>
					<!-- /aside Widget -->


					<div class="aside">
						<h3 class="aside-title">Prix</h3>
						<form method="get" action="{{ path('app_filter', {'id': app.request.get('id')}) }}" id="price-filter-form">
							<div class="price-filter">
								<div id="price-slider"></div>
								<div class="input-number price-min">
									<input id="price-min" name="price_min" type="number" value="{{ minPrice|default(1) }}">
									<span class="qty-up">+</span>
									<span class="qty-down">-</span>
								</div>
								<span>-</span>
								<div class="input-number price-max">
									<input id="price-max" name="price_max" type="number" value="{{ maxPrice|default(1000000) }}">
									<span class="qty-up">+</span>
									<span class="qty-down">-</span>
								</div>
								<button type="submit" class="btn btn-danger mt-2">Filtrer</button>
							</div>
						</form>
					</div>
					<!-- /aside Widget -->
					<!-- /aside Widget -->


				</div>
				<!-- /ASIDE -->

				<!-- STORE -->
				<div
					id="store" class="col-md-9">

					<!-- store products -->
					<div
						class="row">
						<!-- product -->
						{% for allProduct in allProducts %}
						
							{% if allProducts|length > 0 %}
								<div class="col-md-4 col-xs-6">
									<div class="product">
										<div class="product-img">
											<img src="{{asset('uploads/'~ allProduct.productImages[0].imagePath)}}" alt="">
											<div class="product-label">
												<span class="sale">-30%</span>
												<span class="new">NEW</span>
											</div>
										</div>
										<div class="product-body">
											<p class="product-category">{{allProduct.subCategories.getValues[0].name}}</p>
											<h3 class="product-name">
												<a href="#">{{allProduct.name}}</a>
											</h3>
											<h4 class="product-price">{{allProduct.price}}
												francs cfa</h4>
											<div class="product-rating">
												<i class="fa fa-star"></i>
												<i class="fa fa-star"></i>
												<i class="fa fa-star"></i>
												<i class="fa fa-star"></i>
												<i class="fa fa-star"></i>
											</div>
											<div class="product-btns">
												<button class="add-to-wishlist">
													<i class="fa fa-heart-o"></i>
													<span class="tooltipp">add to wishlist</span>
												</button>
												<button class="quick-view">
													<i class="fa fa-eye"></i>
													<span class="tooltipp">quick view</span>
												</button>
											</div>
										</div>
										<div class="add-to-cart">
											<button class="add-to-cart-btn">
												<i class="fa fa-shopping-cart"></i>
												add to cart</button>
										</div>
									</div>
								</div>
							{% else %}
								<div class="col-12">
									<h3 class="text-center">Pas de produits disponibles pour le moment !</h3>
								</div>
							{% endif %}
						{% endfor %}

						{# <div class="clearfix visible-sm visible-xs"></div> #}


					</div>
					<!-- /store products -->

					<!-- store bottom filter -->
					{{knp_pagination_render(allProducts,'partials/pagination.html.twig')}}
					<!-- /store bottom filter -->
				</div>
				<!-- /STORE -->
			</div>
			<!-- /row -->
		</div>
		<!-- /container -->
	</div>
	<!-- /SECTION -->


	<style>

		/* Style du conteneur d'image */
		.product-img {
			height: 250px; /* Hauteur fixe pour la zone d'image */
			width: 100%;
			overflow: hidden;
			position: relative;
		}

		/* Style de l'image */
		.product-img img {
			width: 100%;
			height: 100%;
			object-fit: contain; /* 'contain' pour garantir que l'image soit visible en entier */
		}

		/* Style pour le corps du produit */
		.product-body {
			padding: 15px;
			flex-grow: 1;
			display: flex;
			flex-direction: column;
		}
		.shop {
			height: 250px; /* Hauteur fixe pour la zone d'image */
			width: 100%;
			overflow: hidden;
			position: relative;
		}

		.shop shop-img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
	</style>
	<script>
		document.addEventListener('DOMContentLoaded', function () { // Get the price input elements
const priceMinInput = document.getElementById('price-min');
const priceMaxInput = document.getElementById('price-max');

// Add event listeners for the up/down buttons
document.querySelector('.price-min .qty-up').addEventListener('click', function () {
priceMinInput.value = parseInt(priceMinInput.value) + 100;
});

document.querySelector('.price-min .qty-down').addEventListener('click', function () {
if (parseInt(priceMinInput.value) >= 100) {
priceMinInput.value = parseInt(priceMinInput.value) - 100;
}
});

document.querySelector('.price-max .qty-up').addEventListener('click', function () {
priceMaxInput.value = parseInt(priceMaxInput.value) + 100;
});

document.querySelector('.price-max .qty-down').addEventListener('click', function () {
if (parseInt(priceMaxInput.value) >= 100) {
priceMaxInput.value = parseInt(priceMaxInput.value) - 100;
}
});
});
	</script>
{% endblock %}
