	<style>

		/* Style du conteneur d'image */
		.product-img {
			height: 250px; /* Hauteur fixe pour la zone d'image */
			width: 100%;
			overflow: hidden;
			position: relative;
		}

		/* Style de l'image */
		.product-img img {
			width: 100%;
			height: 100%;
			object-fit: contain; /* 'contain' pour garantir que l'image soit visible en entier */
		}

		/* Style pour le corps du produit */
		.product-body {
			padding: 15px;
			flex-grow: 1;
			display: flex;
			flex-direction: column;
		}
		.shop{
			height: 250px; /* Hauteur fixe pour la zone d'image */
			width: 100%;
			overflow: hidden;
			position: relative;
		}

		.shop shop-img{
			width: 100%;
			height: 100%;
			object-fit: contain;
		}

		/* Amélioration des onglets de navigation */
		.section-tab-nav {
			margin: 0;
			padding: 0;
			list-style: none;
			display: flex;
			flex-wrap: wrap;
		}

		.section-tab-nav li {
			margin-right: 15px;
			margin-bottom: 5px;
		}

		.section-tab-nav li a {
			color: #333;
			padding: 5px 10px;
			border-radius: 4px;
			display: block;
			text-decoration: none;
			transition: all 0.3s;
		}

		.section-tab-nav li.active a {
			color: #D10024;
			font-weight: bold;
		}

		.section-tab-nav li a:hover {
			background-color: rgba(209, 0, 36, 0.1);
		}

		/* Amélioration des conteneurs de produits */
		.products-container {
			min-height: 300px;
		}

		/* Style pour les indicateurs de chargement */
		.loading-spinner {
			padding: 30px;
			text-align: center;
		}

		.loading-spinner i {
			color: #D10024;
			margin-bottom: 10px;
		}

		/* Assurer la visibilité des flèches de navigation */
		.products-slick-nav {
			position: absolute;
			top: -50px;
			right: 15px;
		}

		.products-slick-nav .slick-prev, 
		.products-slick-nav .slick-next {
			display: inline-block;
			width: 30px;
			height: 30px;
			background: #fff;
			border: 1px solid #E4E7ED;
			color: #2B2D42;
			border-radius: 50%;
			margin: 0 2px;
			text-align: center;
			line-height: 30px;
		}

		/* Style pour les tabs */
		.tab-pane {
			display: none;
		}

		.tab-pane.active {
			display: block;
		}

		/* Rendre les flèches de navigation plus visibles et cliquables */
.products-slick-nav {
    position: absolute;
    top: -50px;
    right: 15px;
    z-index: 10;
}

.products-slick-nav .slick-prev, 
.products-slick-nav .slick-next {
    display: inline-block;
    width: 30px;
    height: 30px;
    background: #fff;
    border: 1px solid #E4E7ED;
    color: #2B2D42;
    border-radius: 50%;
    margin: 0 2px;
    cursor: pointer;
    text-align: center;
    line-height: 30px;
    position: relative;
    z-index: 11;
}

.products-slick-nav .slick-prev:hover, 
.products-slick-nav .slick-next:hover {
    background: #D10024;
    color: #fff;
}

/* Ajouter des icônes aux boutons */
.products-slick-nav .slick-prev:before {
    content: "\f104";  /* Icône flèche gauche FontAwesome */
    font-family: 'FontAwesome';
}

.products-slick-nav .slick-next:before {
    content: "\f105";  /* Icône flèche droite FontAwesome */
    font-family: 'FontAwesome';
}

/* Styles pour la section Nouveautés */
#nouveautes-tabs {
    background-color: #f5f5f5;
    border-radius: 5px;
    padding: 5px;
}

#nouveautes-tabs li a {
    padding: 8px 15px;
    margin: 2px;
    border-radius: 3px;
}

#nouveautes-tabs li.active a {
    background-color: #D10024;
    color: white;
}

/* Styles pour la section des sous-catégories de produits */
.subcategory-tabs {
    background-color: #f0f0f0;
    border-radius: 5px;
    padding: 5px;
}

.subcategory-link {
    font-weight: 500;
    padding: 8px 15px !important;
    margin: 2px;
    border-radius: 3px;
    border: 1px solid #e0e0e0;
}

.section-tab-nav li.active .subcategory-link {
    background-color: #D10024;
    color: white !important;
    border-color: #D10024;
}
	</style>


{% block javascripts %}

<script>
$(document).ready(function() {
    // Initialize all product slick carousels
    $('.products-slick').each(function() {
        var $this = $(this);
        var $nav = $($this.attr('data-nav'));
        
        $this.slick({
            slidesToShow: 4,
            slidesToScroll: 1,
            autoplay: true,
            autoplaySpeed: 3000,
            infinite: true,
            speed: 300,
            dots: false,
            arrows: true,
            appendArrows: $nav,
            responsive: [
                {
                    breakpoint: 991,
                    settings: {
                        slidesToShow: 2,
                        slidesToScroll: 1,
                    }
                },
                {
                    breakpoint: 480,
                    settings: {
                        slidesToShow: 1,
                        slidesToScroll: 1,
                    }
                },
            ]
        });
    });

    // Handle tab switching for new products
    $('#new-products-tabs a').on('click', function(e) {
        e.preventDefault();
        $(this).tab('show');
        
        // Find the target tab and initialize slick if needed
        var target = $(this).attr('href');
        initializeSlickIfNeeded(target);
    });
    
    // Handle tab switching for all products
    $('#all-products-tabs a').on('click', function(e) {
        e.preventDefault();
        $(this).tab('show');
        
        // Find the target tab and initialize slick if needed
        var target = $(this).attr('href');
        initializeSlickIfNeeded(target);
    });
    
    // Handle tab switching for top sales
    $('#top-sales-tabs a').on('click', function(e) {
        e.preventDefault();
        $(this).tab('show');
        
        // Find the target tab and initialize slick if needed
        var target = $(this).attr('href');
        initializeSlickIfNeeded(target);
    });
    
    // Function to initialize slick carousel if needed
    function initializeSlickIfNeeded(tabId) {
        var $tab = $(tabId);
        var $slick = $tab.find('.products-slick');
        
        // If slick is not initialized, initialize it
        if (!$slick.hasClass('slick-initialized')) {
            var $nav = $($slick.attr('data-nav'));
            
            $slick.slick({
                slidesToShow: 4,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 3000,
                infinite: true,
                speed: 300,
                dots: false,
                arrows: true,
                appendArrows: $nav,
                responsive: [
                    {
                        breakpoint: 991,
                        settings: {
                            slidesToShow: 2,
                            slidesToScroll: 1,
                        }
                    },
                    {
                        breakpoint: 480,
                        settings: {
                            slidesToShow: 1,
                            slidesToScroll: 1,
                        }
                    },
                ]
            });
        } else {
            // If already initialized, refresh the slick carousel
            $slick.slick('setPosition');
        }
    }
});
</script>
{% endblock %}
{% endblock %}
