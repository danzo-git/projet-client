{% extends 'base.html.twig' %}

{% block title %}Accueil - Electro
{% endblock %}

{% block content %}
	<!-- SECTION -->
	<div
		class="section">
		<!-- container -->
		<div
			class="container">
			<!-- row -->
	<div class="row">
    <!-- shop -->
    {% for category in productsByRandom %}
        {% if category.subCategories is not empty %}
            {% set randomSubCategory = category.subCategories|first %}
            {% if randomSubCategory.products is not empty %}
                {% set randomProduct = randomSubCategory.products|first %}
                <div class="col-md-4 col-xs-6">
                    <div class="shop">
                        <!-- Affichage de l'image du produit -->
                        <div class="shop-img">
                            {% if randomProduct.productImages is not empty %}
                                {% set randomProductImage = randomProduct.productImages|first %}
                                <img src="{{ asset('uploads/' ~ randomProductImage.imagePath) }}" alt="{{ randomProduct.name }}">
                            {% else %}
                                <img src="{{ asset('img/placeholder.png') }}" alt="No image available">
                            {% endif %}
                        </div>

                        <!-- Affichage du nom de la sous-catégorie -->
                        <div class="shop-body">
                            <h3>Collection<br>{{ randomSubCategory.name }}</h3>
                            <a href="#" class="cta-btn">Achetez maintenant ! <i class="fa fa-arrow-circle-right"></i></a>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endif %}
    {% endfor %}
    <!-- /shop -->
</div>
		</div>
		<!-- /container -->
	</div>
	<!-- /SECTION -->

