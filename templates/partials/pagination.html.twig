{% if pageCount > 1 %}

 <!-- store bottom filter -->
                <div class="store-filter clearfix">
                    <span class="store-qty">Showing 20-100 products</span>
                  
                    <ul class="store-pagination">
                      {% if previous is defined %}
                        <li><a href="{{path(route,query|merge({(pageParameterName):previous}))}}"><i class="fa fa-angle-left"></i></a></li>
                     {% endif %}

                     {% for page in pagesInRange %}
                     {% if page != current %}
                         <li  ><a href="{{path(route,query|merge({(pageParameterName):page}))}}">{{page}}</a></li>
                    {% else %}
                      <li class="active" ><a href="{{path(route,query|merge({(pageParameterName):page}))}}">{{page}}</a></li>
                    {% endif %}
                     {% endfor %}
                            
                        {% if next is defined %}
                        <li><a href="{{path(route,query|merge({(pageParameterName):next}))}}"><i class="fa fa-angle-right"></i></a></li>
                     {% endif %}
                    </ul>
                   
                </div>
                <!-- /store bottom filter -->
                {% endif %}