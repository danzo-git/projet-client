{% extends 'base.html.twig' %}

{% block title %}Liste des Produits
{% endblock %}

{% block content %}
	<script>

		// Activer les tooltips

	</script>
	<div
		class="container-fluid py-4">
		<!-- En-tête -->
		<div class="row mb-4">
			<div class="col-12">
				<div class="card border-0 shadow-sm">
					<div class="card-body d-flex justify-content-between align-items-center">
						<div>
							<h1 class="card-title mb-0">
								<i class="fa fa-cubes text-primary me-2"></i>Gestion des Produits</h1>
							<p class="text-muted mb-0">{{ products|length }}
								produits dans votre catalogue</p>
						</div>
						<a href="{{ path('app_product_new') }}" class="btn btn-primary shadow-sm">
							<i class="fa fa-plus me-2"></i>Nouveau produit
						</a>
					</div>
				</div>
			</div>
		</div>

		<div class=" mt-5">
			<h1 class="text-center mb-4">🛍️ Liste des Produits</h1>
			{% include 'layouts/_flash_message.html.twig' %}
			<div class="card shadow-sm">
				<div class="card-body">
					<table class="table table-striped table-hover">
						<thead class="table-dark">
							<tr>
								<th>Image</th>
								<th>Nom</th>
								<th>categorie</th>
								<th>Description</th>
								<th>Prix</th>
								<th>Taille</th>
								<th>stock</th>
								<th class="text-center">Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for product in products %}
								<tr>
									<td>
										{% if product.productImages is defined and product.productImages|length > 0 %}
											<img src="{{ asset('uploads/' ~ product.productImages[0].imagePath) }}" alt="{{ product.name }}" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">
										{% else %}
											<div style="width: 60px; height: 60px; background-color: #f8f8f8; border-radius: 5px; display: flex; align-items: center; justify-content: center;">
												<i class="fa fa-image text-muted"></i>
											</div>
										{% endif %}
									</td>
									<td>{{ product.name }}</td>
									<td>
										{% for subCategory in product.subCategories %}
											{{ subCategory.getCategory().name }}
											{% if not loop.last %},
											{% endif %}
										{% endfor %}
									</td>
									<td>{{ product.description|slice(0,60) }}</td>
									<td>{{ product.price }}
										fcfa</td>
									<td>{{ product.taille }}</td>
									<td>{{ product.stock > 0 ? product.stock :"<span class='badge badge-danger'>Stock epuisé </span> "}}</td>
									<td class="text-center">
										<div class="d-flex justify-content-center gap-2">
											<a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-sm btn-outline-info" data-bs-toggle="tooltip" title="Voir détails">
												<i class="fa fa-eye"></i>
											</a>

											<a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-sm btn-outline-warning" data-bs-toggle="tooltip" title="Modifier">
												<i class="fa fa-edit"></i>
											</a>

											<a href="{{ path('app_product_stock', {'id': product.id}) }}" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Gérer le stock">
												<i class="fa fa-home"></i>
											</a>

											
											<a href="{{ path('app_product_stock_history', {'id': product.id}) }}" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="Historique">
												<i class="fa fa-history"></i>
											</a>

											<div class="btn-group">

												{{ include('product/_delete_form.html.twig') }}
											</div>
										</div>

										<!-- Modal de suppression -->
										
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="6" class="text-center text-muted">
										<i class="fas fa-exclamation-circle"></i>
										Aucun produit trouvé.
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>

			


	{% endblock %}
