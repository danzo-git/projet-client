{% extends 'base.html.twig' %}

{% block title %}Liste des Produits
{% endblock %}

{% block content %}
	<div class="container mt-5">
		<h1 class="text-center mb-4">🛍️ Liste des Produits</h1>
		{% include 'layouts/_flash_message.html.twig' %}
		<div class="card shadow-sm">
			<div class="card-body">
				<table class="table table-striped table-hover">
					<thead class="table-dark">
						<tr>
							<th>ID</th>
							<th>Nom</th>
							<th>categorie</th>
							<th>Description</th>
							<th>Prix</th>
							<th>Taille</th>
							<th>stock</th>
							<th class="text-center">Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for product in products %}
							<tr>
								<td>{{ product.id }}</td>
								<td>{{ product.name }}</td>
								<td>
									{% for subCategory in product.subCategories %}
										{{ subCategory.getCategory().name }}
										{% if not loop.last %},
										{% endif %}
									{% endfor %}
								</td>
								<td>{{ product.description|slice(0,60) }}</td>
								<td>{{ product.price }}
									€</td>
								<td>{{ product.taille }}</td>
									<td>{{ product.stock > 0 ? product.stock :"<span class='badge badge-danger'>Stock epuisé </span> "}}</td>
								<td class="text-center">
									<a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-info btn-sm">
										<i class="fas fa-eye"></i>
										Voir
									</a>
									<a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-warning btn-sm">
										<i class="fas fa-edit"></i>
										Modifier
									</a>
									<a href="{{ path('app_product_edit', {'id': product.id}) }}" class="">
										<i class="fas fa-trash"></i>
										{{ include('product/_delete_form.html.twig') }}

									</a>
										<a href="{{ path('app_product_stock', {'id': product.id}) }}" class="btn btn-warning btn-sm">
										<i class="fas fa-stock"></i>
										stock
									</a>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="6" class="text-center text-muted">
									<i class="fas fa-exclamation-circle"></i>
									Aucun produit trouvé.
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

		<div class="text-center mt-4">
			<a href="{{ path('app_product_new') }}" class="btn btn-danger btn-lg shadow-sm">
				<i class="fas fa-plus"></i>
				Ajouter un nouveau produit
			</a>
		</div>
	</div>
{% endblock %}
