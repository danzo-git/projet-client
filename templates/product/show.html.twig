{% extends 'base.html.twig' %}

{% block title %}Produit 
{% endblock %}

{% block content %}
	<h1>{{product.name}}</h1>
	<div class="container">
		<table class="table">
			<tbody>
				<tr>
				
				</tr>
				<tr>
					<th>Nom</th>
					<td>{{ product.name }}</td>
				</tr>
				<tr>
					<th>Description</th>
					<td>{{ product.description }}</td>
				</tr>
				<tr>
					<th>Prix</th>
					<td>{{ product.price }}</td>
				</tr>
				<tr>
					<th>Taille</th>
					<td>{{ product.taille }}</td>
				</tr>
				<tr>
					<th>Image</th>
					<td>
						{% for image in product.productImages %}
							<img src="{{ asset('uploads/' ~ image.imagePath) }}" alt="Product Image" width="150">
						{% endfor %}
					</td>
				</tr>
			</tbody>
		</table>
	</div>
	<a href="{{ path('app_product_index') }}">
		<i class="fa fa-arrow-left"></i>
	</a>

	<a href="{{ path('app_product_edit', {'id': product.id}) }}">
		<i class="fa fa-edit"></i>
	</a>
	<a href="{{ path('app_product_stock_history', {'id': product.id}) }}" class="fa fa-historique">
		<i class="fa fa-history"></i>

	</a>

	{{ include('product/_delete_form.html.twig') }}
</div>{% endblock %}
