{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block content %}
<div class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <form method="post" class="login-form">
                            <h1 class="text-center mb-4">Inscription</h1>

                            {{ form_errors(registrationForm) }}

                            {{ form_start(registrationForm) }}
                                <div class="form-group mb-3">
                                    {{ form_row(registrationForm.firstName, {
                                        'label': 'Prénom',
                                        'attr': {'class': 'form-control','Placeholder':"Joe Arsene"}
                                    }) }}
                                </div>

                                <div class="form-group mb-3">
                                    {{ form_row(registrationForm.lastName, {
                                        'label': 'Nom',
                                        'attr': {'class': 'form-control','Placeholder':"Gnamakou"}
                                    }) }}
                                </div>

                                <div class="form-group mb-3">
                                    {{ form_row(registrationForm.email, {
                                        'label': 'Email',
                                        'attr': {'class': 'form-control','Placeholder':"xyz@gmail.com"}
                                        
                                    }) }}
                                </div>

                                <div class="form-group mb-3">
                                    {{ form_row(registrationForm.plainPassword, {
                                        'label': 'Mot de passe',
                                        'attr': {'class': 'form-control','Placeholder':"xxxxxx"}
                                    }) }}
                                </div>

                                <div class="form-group mb-3">
                                    {{ form_row(registrationForm.agreeTerms, {
                                        'label': 'J\'accepte les conditions d\'utilisation'
                                    }) }}
                                </div>

                                <div class="form-group mb-3">
                                    <button type="submit" class="btn btn-primary btn-block w-100">
                                        S'inscrire
                                    </button>
                                </div>

                                <div class="text-center">
                                    <p>Vous avez déjà un compte ? <a href="{{ path('app_login') }}">Connectez-vous</a></p>
                                </div>
                            {{ form_end(registrationForm) }}
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
