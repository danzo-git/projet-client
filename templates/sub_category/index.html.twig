{% extends 'base.html.twig' %}

{% block title %}Gestion des Sous-Catégories{% endblock %}

{% block content %}

<div class="container mt-5">
    <h1 class="text-center mb-4">📂 Sous-Catégories</h1>

    <div class="card shadow-sm">
     {% include 'layouts/_flash_message.html.twig' %}
        <div class="card-body">
            <table class="table table-striped table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>categorie</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for sub_category in sub_categories %}
                    <tr>
                        <td>{{ sub_category.id }}</td>
                        <td>{{ sub_category.name }}</td>
                          <td>{{ sub_category.category.name }}</td>

                        <td class="text-center">
                            <a href="{{ path('app_sub_category_show', {'id': sub_category.id}) }}" class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i> Voir
                            </a>
                            <a href="{{ path('app_sub_category_edit', {'id': sub_category.id}) }}" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Modifier
                            </a>
                             {{ include('sub_category/_delete_form.html.twig') }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-muted">
                            <i class="fas fa-exclamation-circle"></i> Aucune sous-catégorie trouvée.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="{{ path('app_sub_category_new') }}" class="btn btn-danger btn-lg shadow-sm">
            <i class="fas fa-plus"></i> Ajouter une nouvelle sous-catégorie
        </a>
    </div>
</div>
{% endblock %}
