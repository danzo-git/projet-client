{% extends 'base.html.twig' %}

{% block title %}Gestion des Sous-Catégories{% endblock %}

{% block content %}
<div class="row mb-4">
			<div class="col-12">
				<div class="card border-0 shadow-sm">
					<div class="card-body d-flex justify-content-between align-items-center">
						<div>
							<h1 class="card-title mb-0">
								<i class="fa fa-sitemap text-primary me-2"></i>Gestion des sous-categories</h1>
							<p class="text-muted mb-0">{{ sub_categories|length }}
								sous-categories dans votre catalogue</p>
						</div>
						<a href="{{ path('app_sub_category_index') }}" class="btn btn-primary shadow-sm">
							<i class="fa fa-plus me-2"></i>Nouvelle Sous-categorie
						</a>
					</div>
				</div>
			</div>
		</div>
<div class="container mt-5">
    <h1 class="text-center mb-4">📂 Sous-Catégories</h1>

    <div class="card shadow-sm">
     {% include 'layouts/_flash_message.html.twig' %}
        <div class="card-body">
            <table class="table table-striped table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>categorie</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for sub_category in sub_categories %}
                    <tr>
                        <td>{{ sub_category.id }}</td>
                        <td>{{ sub_category.name }}</td>
                          <td>{{ sub_category.category.name }}</td>

                        <td class="text-center">
                            <a href="{{ path('app_sub_category_show', {'id': sub_category.id}) }}" class="btn btn-info btn-sm">
                                <i class="fa fa-eye"></i> 
                            </a>
                            <a href="{{ path('app_sub_category_edit', {'id': sub_category.id}) }}" class="btn btn-warning btn-sm">
                                <i class="fa fa-edit"></i> 
                            </a>
                             {{ include('sub_category/_delete_form.html.twig') }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-muted">
                            <i class="fa fa-exclamation-circle"></i> Aucune sous-catégorie trouvée.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    
</div>
{% endblock %}
