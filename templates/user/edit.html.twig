{% extends 'base.html.twig' %}

{% block title %}Modifier Utilisateur{% endblock %}

{% block content %}
<div class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <h1 class="text-center mb-4">Modifier Utilisateur</h1>
                <div class="card">
                    <div class="card-body">
                        {{ form_start(form, {'attr': {'class': 'form'}}) }}
                            <div class="mb-3">
                                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Email'}}) }}
                            </div>
                            <div class="mb-3">
                                <label for="roles" class="form-label">Rôles</label>
                                <div>
                                    {% for choice in form.roles %}
                                        <div class="form-check">
                                            {{ form_widget(choice, {'attr': {'class': 'form-check-input'}}) }}
                                            {{ form_label(choice, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            {# <div class="mb-3">
                                {{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe'}}) }}
                            </div> #}
                            <div class="mb-3">
                                {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
                            </div>
                            <div class="mb-3">
                                {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Nom'}}) }}
                            </div>
                            <button type="submit" class="btn btn-primary">Modifier</button>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}